# Server
PORT=3000
BASE_URL=https://your-app.up.railway.app      # your public URL, no trailing slash

# Postgres (Railway sets DATABASE_URL for you when you add a Postgres service)
DATABASE_URL=postgres://user:pass@host:5432/db
PGSSL=false                                   # set true if your database requires SSL

# Secrets — generate with:  openssl rand -hex 32
SESSION_SECRET=change-me
ENCRYPTION_KEY=64-hex-characters-from-openssl-rand-hex-32

# Meta app (developers.facebook.com → your app → App settings → Basic)
FB_APP_ID=
FB_APP_SECRET=
FB_CONFIG_ID=                                 # Facebook Login for Business configuration ID (leave empty for classic Facebook Login)
GRAPH_VERSION=v23.0
ALLOWED_FB_IDS=                               # optional: comma-separated Facebook user IDs allowed to log in

# Matching
TZ_NAME=Asia/Phnom_Penh
LIVE_GAP_MINUTES=30                           # campaigns starting within this many minutes = one live

# Telegram daily report (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                             # group chat IDs start with -100…
REPORT_TIME=21:00

# Auto-sync schedule (cron, in TZ_NAME). Default: minute 5 of every hour, 08:00–23:00
AUTO_SYNC_CRON=5 8-23 * * *
