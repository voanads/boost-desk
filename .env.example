# Server
PORT=3000
BASE_URL=https://your-app.up.railway.app      # your public URL, no trailing slash

# Postgres (Railway sets DATABASE_URL for you when you add a Postgres service)
DATABASE_URL=postgres://user:pass@host:5432/db
PGSSL=false                                   # set true if your database requires SSL

# Secrets — generate with:  openssl rand -hex 32
SESSION_SECRET=change-me
ENCRYPTION_KEY=64-hex-characters-from-openssl-rand-hex-32

# Meta app (developers.facebook.com → your app → App settings → Basic)
FB_APP_ID=
FB_APP_SECRET=
FB_CONFIG_ID=                                 # Facebook Login for Business configuration ID (leave empty for classic Facebook Login)
GRAPH_VERSION=v25.0
ALLOWED_FB_IDS=                               # optional: comma-separated Facebook user IDs allowed to log in

# Matching
TZ_NAME=Asia/Phnom_Penh
LIVE_GAP_MINUTES=30                           # campaigns starting within this many minutes = one live

# Telegram daily report (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                             # group chat IDs start with -100…
REPORT_TIME=21:00

# Background auto sync: new campaigns every 5 min, hourly refresh, 30-day refresh at 05:30. Set to off to disable.
AUTO_SYNC=on
# Facebook ID of the app owner who controls auto sync for every account (optional).
OWNER_FB_ID=

# Tax added to the total in client reports (percent). 0 turns it off.
TAX_RATE=10

# Admin website (/admin) Google sign-in — optional. Create an OAuth client (Web) in Google Cloud with the
# redirect URI <BASE_URL>/auth/google/callback. People are allowed in Admin → Settings → Admin website.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# One-time copy of the old Ads & Profit Tracker into the Profit tab (optional; only runs while Profit is empty)
TRACKER_URL=
TRACKER_EXPORT_KEY=

# Database backups (docs/backup.md). Off-site storage, S3-compatible (Cloudflare R2, Backblaze B2, AWS S3…).
# When set, the nightly file is stored there and Telegram only gets a short "backup OK" note.
BACKUP_S3_ENDPOINT=                           # e.g. https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto                         # R2: auto; AWS: e.g. ap-southeast-1
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_TELEGRAM_FILE=off                      # on = also send the file to the owner's Telegram
# Encrypts the whole backup file (openssl rand -hex 32). Keep a copy OUTSIDE Railway: without it a backup can't be opened.
BACKUP_KEY=
